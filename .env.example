# Server
PORT=3001
NODE_ENV=development
# Public base URL for webhook callbacks (use ngrok URL in dev if Exotel/ElevenLabs need to reach your machine)
APP_BASE_URL=http://localhost:3001
# Frontend dev server origin — allowed by CORS when UI runs on Vite (:5173)
FRONTEND_URL=http://localhost:5173
# Zoho sync schedule (cron syntax). Default: every 3 hours at minute 0
ZOHO_SYNC_CRON=0 */3 * * *

# MongoDB — use Atlas connection string or local: mongodb://127.0.0.1:27017/offline-devices-caller
MONGODB_URI=mongodb://127.0.0.1:27017/offline-devices-caller

# Zoho region: use .in for India, .com for global
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_PROJECTS_API=https://projectsapi.zoho.in

ZOHO_CLIENT_ID=1000.FFZTH1XFKK191L8XT28IM6OAK0PJBM
ZOHO_CLIENT_SECRET=e4f04e5c7747ae31f510f8e92277a4135c274d0376
ZOHO_REFRESH_TOKEN=1000.d8716d8a8cfd92bf9c9ac2377c9a4eca.e7ff28fa99b5004f19e48fa6c7faa070
ZOHO_PORTAL_ID=313488000000040622

# Names as they appear in Zoho Projects
ZOHO_PROJECT_NAME=PR-34 Data Mapping
ZOHO_PARENT_TASK_NAME=Offline Devices Data

# Custom field API names on task subtasks (discover via Zoho settings/fields API)
ZOHO_FIELD_CX_NAME=cx_name
ZOHO_FIELD_CX_ID=cx_id
ZOHO_FIELD_CX_NUMBER=cx_number
ZOHO_FIELD_TOTAL_UNITS=total_units
ZOHO_FIELD_OFFLINE_UNITS=offline_units
ZOHO_FIELD_UPDATED_EXPIRY=updated_expiry

# Exotel (Phase 4 — leave blank until ready)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com
# Optional override; default is APP_BASE_URL/webhooks/exotel/status
EXOTEL_STATUS_CALLBACK_URL=

# ElevenLabs (Phase 5 — leave blank until ready)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# HMAC secret from ElevenLabs webhook settings (enables signature verification)
ELEVENLABS_WEBHOOK_SECRET=
