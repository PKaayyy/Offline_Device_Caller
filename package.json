{
  "name": "offline-devices-caller",
  "version": "0.1.0",
  "description": "Pull offline-device customers from Zoho Projects and trigger Exotel calls to ElevenLabs agents",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon src/index.js",
    "dev:frontend": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "test:zoho": "node scripts/test-zoho.js"
  },
  "keywords": [
    "zoho",
    "exotel",
    "elevenlabs",
    "mern"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.3",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
